{
  "version": "2.0",
  "extensions": {
    "queues": {
      "batchSize": 4,
      "newBatchThreshold": 2,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:05:00",
      "messageEncoding": "base64"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Host.Results": "Information",
      "Function": "Information"
    }
  }
}
