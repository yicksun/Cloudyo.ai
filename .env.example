# Copy to .env for CLI commands and apps/web/.env.local for Next.js.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cloudyo?sslmode=require&connection_limit=5
SITE_URL=http://localhost:3000
PUBLIC_CONTENT_MODE=database
APP_ENV=development
# Generate independent values; never use example placeholders in production.
OUTBOX_ENCRYPTION_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
ABUSE_HASH_SECRET=REPLACE_WITH_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
INTERNAL_EMAIL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# No email is sent unless explicitly configured.
EMAIL_MODE=disabled
EMAIL_FROM=
EMAIL_TEST_ALLOWLIST=
ACS_EMAIL_ENDPOINT=
ACS_EVENT_SOURCE=
EMAIL_QUEUE_URL=
EmailQueue__queueServiceUri=
MEDIA_STORAGE_URL=
MEDIA_EVENT_SOURCE=
# Azure Functions host storage/identity settings are configured separately.
