@description('Azure region.')
param location string
@description('Resource name prefix.')
param prefix string
@description('Common nonsecret tags.')
param tags object
@description('Web managed identity resource ID.')
param webIdentityId string
@description('Web managed identity client ID.')
param webClientId string
@description('Worker managed identity resource ID.')
param workerIdentityId string
@description('Worker managed identity client ID.')
param workerClientId string
@description('Release runner principal; deployment access never belongs to runtime identities.')
param releasePrincipalId string
@description('Web delegated subnet ID.')
param webSubnetId string
@description('Worker delegated subnet ID.')
param workerSubnetId string
@description('Private Key Vault URI.')
param vaultUri string
@description('Isolated Functions host storage account.')
param hostStorageName string
@description('Business Blob endpoint.')
param businessBlobUrl string
@description('Business Queue endpoint.')
param businessQueueUrl string
@description('Entra-authenticated Application Insights connection string; not a credential.')
param insightsConnectionString string
@description('Actual Front Door HTTPS origin.')
param siteUrl string
@description('Actual Front Door profile identifier for the ingress restriction.')
param frontDoorId string
@description('Owner-approved real internal recipient.')
param internalEmail string
@description('Real single-tenant Entra client ID.')
param entraClientId string

resource webPlan 'Microsoft.Web/serverfarms@2025-03-01' = {
  // checkov:skip=CKV_AZURE_225:The approved S1 single-instance baseline is not zone-redundant; upgrading changes cost.
  name: 'asp-${prefix}'
  location: location
  tags: tags
  kind: 'linux'
  sku: { name: 'S1', tier: 'Standard', capacity: 1 }
  properties: { reserved: true }
}
resource workerPlan 'Microsoft.Web/serverfarms@2025-03-01' = {
  // checkov:skip=CKV_AZURE_225:The approved EP1 single-instance baseline is not zone-redundant; upgrading changes cost.
  name: 'asp-${prefix}-worker'
  location: location
  tags: tags
  kind: 'elastic'
  sku: { name: 'EP1', tier: 'ElasticPremium', capacity: 1 }
  properties: { reserved: true, maximumElasticWorkerCount: 1 }
}
var common = [
  { name: 'APP_ENV', value: 'production' }
  { name: 'NODE_ENV', value: 'production' }
  { name: 'SITE_URL', value: siteUrl }
  { name: 'INTERNAL_EMAIL', value: internalEmail }
  { name: 'OUTBOX_ENCRYPTION_KEY', value: '@Microsoft.KeyVault(SecretUri=${vaultUri}secrets/outbox-encryption-key)' }
  { name: 'ABUSE_HASH_SECRET', value: '@Microsoft.KeyVault(SecretUri=${vaultUri}secrets/abuse-hash-secret)' }
  { name: 'MEDIA_STORAGE_URL', value: businessBlobUrl }
  { name: 'SCM_DO_BUILD_DURING_DEPLOYMENT', value: 'false' }
  { name: 'ENABLE_ORYX_BUILD', value: 'false' }
]
var disabledFunctions = [for name in ['dispatch', 'sendEmail', 'emailDelivery', 'mediaScan', 'poison', 'maintenance']: {
  name: 'AzureWebJobs.${name}.Disabled'
  value: 'true'
}]
resource web 'Microsoft.Web/sites@2025-03-01' = {
  // checkov:skip=CKV_AZURE_17:Public marketing visitors and Standard Front Door do not supply client certificates; staff use Entra.
  // checkov:skip=CKV_AZURE_212:Approved one-instance cost baseline; no failover or availability guarantee is claimed.
  // checkov:skip=CKV_AZURE_222:Approved Standard Front Door origin requires public ingress filtered by both service tag and exact FDID.
  name: 'app-${prefix}'
  location: location
  tags: tags
  kind: 'app,linux'
  identity: { type: 'UserAssigned', userAssignedIdentities: { '${webIdentityId}': {} } }
  properties: {
    serverFarmId: webPlan.id
    reserved: true
    httpsOnly: true
    publicNetworkAccess: 'Enabled'
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
    virtualNetworkSubnetId: webSubnetId
    keyVaultReferenceIdentity: webIdentityId
    outboundVnetRouting: { applicationTraffic: true }
    siteConfig: {
      linuxFxVersion: 'NODE|22-lts'
      appCommandLine: 'node apps/web/server.js'
      alwaysOn: true
      healthCheckPath: '/health/ready'
      minTlsVersion: '1.2'
      scmMinTlsVersion: '1.2'
      ftpsState: 'Disabled'
      http20Enabled: true
      remoteDebuggingEnabled: false
      ipSecurityRestrictionsDefaultAction: 'Deny'
      ipSecurityRestrictions: [
        {
          name: 'this-front-door-only'
          priority: 100
          action: 'Allow'
          ipAddress: 'AzureFrontDoor.Backend'
          tag: 'ServiceTag'
          headers: { 'x-azure-fdid': [frontDoorId] }
        }
      ]
      scmIpSecurityRestrictionsUseMain: false
      scmIpSecurityRestrictionsDefaultAction: 'Deny'
      appSettings: concat(common, [
        { name: 'HOSTNAME', value: '0.0.0.0' }
        { name: 'PUBLIC_CONTENT_MODE', value: 'database' }
        { name: 'AZURE_CLIENT_ID', value: webClientId }
        { name: 'DATABASE_URL', value: '@Microsoft.KeyVault(SecretUri=${vaultUri}secrets/database-web-url)' }
        { name: 'NEXTAUTH_URL', value: siteUrl }
        { name: 'NEXTAUTH_SECRET', value: '@Microsoft.KeyVault(SecretUri=${vaultUri}secrets/nextauth-secret)' }
        { name: 'ENTRA_TENANT_ID', value: tenant().tenantId }
        { name: 'ENTRA_CLIENT_ID', value: entraClientId }
        { name: 'ENTRA_CLIENT_SECRET', value: '@Microsoft.KeyVault(SecretUri=${vaultUri}secrets/entra-client-secret)' }
      ])
    }
  }
}
resource worker 'Microsoft.Web/sites@2025-03-01' = {
  // checkov:skip=CKV_AZURE_17:Private-only non-HTTP worker; SCM uses Entra bearer authentication rather than client certificates.
  // checkov:skip=CKV_AZURE_212:Approved one-instance cost baseline; no failover or availability guarantee is claimed.
  // checkov:skip=CKV_AZURE_213:No HTTP function exists; the release gate checks actual registration of all six triggers instead.
  name: 'func-${prefix}'
  location: location
  tags: tags
  kind: 'functionapp,linux'
  identity: { type: 'UserAssigned', userAssignedIdentities: { '${workerIdentityId}': {} } }
  properties: {
    serverFarmId: workerPlan.id
    reserved: true
    httpsOnly: true
    publicNetworkAccess: 'Disabled'
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
    virtualNetworkSubnetId: workerSubnetId
    keyVaultReferenceIdentity: workerIdentityId
    outboundVnetRouting: { applicationTraffic: true, contentShareTraffic: true }
    siteConfig: {
      linuxFxVersion: 'NODE|22'
      minTlsVersion: '1.2'
      scmMinTlsVersion: '1.2'
      ftpsState: 'Disabled'
      http20Enabled: true
      remoteDebuggingEnabled: false
      minimumElasticInstanceCount: 1
      functionAppScaleLimit: 1
      ipSecurityRestrictionsDefaultAction: 'Deny'
      scmIpSecurityRestrictionsDefaultAction: 'Deny'
      appSettings: concat(common, [
        { name: 'AZURE_CLIENT_ID', value: workerClientId }
        { name: 'DATABASE_URL', value: '@Microsoft.KeyVault(SecretUri=${vaultUri}secrets/database-worker-url)' }
        { name: 'FUNCTIONS_WORKER_RUNTIME', value: 'node' }
        { name: 'FUNCTIONS_EXTENSION_VERSION', value: '~4' }
        { name: 'WEBSITE_RUN_FROM_PACKAGE', value: '1' }
        { name: 'WEBSITE_CONTENTSHARE', value: 'worker-production' }
        { name: 'WEBSITE_CONTENTAZUREFILECONNECTIONSTRING', value: '@Microsoft.KeyVault(SecretUri=${vaultUri}secrets/worker-content-connection)' }
        { name: 'WEBSITE_SKIP_CONTENTSHARE_VALIDATION', value: '1' }
        { name: 'AzureWebJobsStorage__accountName', value: hostStorageName }
        { name: 'AzureWebJobsStorage__credential', value: 'managedidentity' }
        { name: 'AzureWebJobsStorage__clientId', value: workerClientId }
        { name: 'EMAIL_QUEUE_URL', value: '${businessQueueUrl}cloudyo-email' }
        { name: 'EmailQueue__queueServiceUri', value: businessQueueUrl }
        { name: 'EmailQueue__credential', value: 'managedidentity' }
        { name: 'EmailQueue__clientId', value: workerClientId }
        { name: 'EMAIL_MODE', value: 'disabled' }
        { name: 'APPLICATIONINSIGHTS_CONNECTION_STRING', value: insightsConnectionString }
        { name: 'APPLICATIONINSIGHTS_AUTHENTICATION_STRING', value: 'Authorization=AAD;ClientId=${workerClientId}' }
      ], disabledFunctions)
    }
  }
}
resource webScm 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2025-03-01' = {
  parent: web
  name: 'scm'
  properties: { allow: false }
}
resource webFtp 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2025-03-01' = {
  parent: web
  name: 'ftp'
  properties: { allow: false }
}
resource workerScm 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2025-03-01' = {
  parent: worker
  name: 'scm'
  properties: { allow: false }
}
resource workerFtp 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2025-03-01' = {
  parent: worker
  name: 'ftp'
  properties: { allow: false }
}
resource webDeployAccess 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(web.id, releasePrincipalId, 'Website Contributor')
  scope: web
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'de139f84-1756-47ae-9be6-808fbbe84772')
    principalId: releasePrincipalId
    principalType: 'ServicePrincipal'
  }
}
resource workerDeployAccess 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(worker.id, releasePrincipalId, 'Website Contributor')
  scope: worker
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'de139f84-1756-47ae-9be6-808fbbe84772')
    principalId: releasePrincipalId
    principalType: 'ServicePrincipal'
  }
}
resource workerPlanRead 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(workerPlan.id, releasePrincipalId, 'Reader')
  scope: workerPlan
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')
    principalId: releasePrincipalId
    principalType: 'ServicePrincipal'
  }
}
output webId string = web.id
output workerId string = worker.id
output webName string = web.name
output workerName string = worker.name
output webHostname string = web.properties.defaultHostName
output workerHostname string = worker.properties.defaultHostName
